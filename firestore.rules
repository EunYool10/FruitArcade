rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users  (private: holds the Google email)
// Document ID: Firebase Auth uid
// Fields:
//   - profile: map (required)
//       uid (== document id, immutable), email (string|null, immutable),
//       createdAt (string, immutable), displayName, photoURL, lastLoginAt,
//       nickname, avatar, title, frame (strings or null, size-limited). No other keys.
//   - statistics: map (<= 40 keys) - play counts / high scores (older versions left extra keys)
//   - achievements: map (<= 100 keys) - unlocked achievement id -> date
//   - settings: map (<= 40 keys) - game settings
//   - inventory: map (<= 100 keys) - shop item id -> purchase date (coins live in statistics)
//   - stages: map (<= 100 keys) - puzzle stage number -> best stars
//   No other top-level fields and no subcollections.
//
// Collection: leaderboards/{boardId}/scores  (public)
// Board ID: <game>_<period>
//   - game:   memory | suika | dash | puzzle | slice
//   - period: all            -> all-time board
//             d<dayIndex>    -> daily board, days since 1970-01-01 in KST (UTC+9)
//             w<weekIndex>   -> weekly board, Monday-start weeks since 1969-12-29 in KST
// Document ID: Firebase Auth uid (one entry per player per board)
// Fields (public, no email or Google profile data):
//   - uid: string (== document id == request.auth.uid, immutable)
//   - name: string (1-40 chars, no control characters, may not pose as staff
//           like "Tester", "QA", "관리자" unless written by an admin)
//   - avatar: string (1-16 chars)
//   - score: int (0 <= score <= per-game cap, may only go up, at most every 3 s;
//           name/avatar/title/frame may be refreshed alone with the same score)
//   - at: timestamp (== request.time)
//   - title, frame: optional ids ([a-z0-9_], 1-32) of the worn title and avatar frame;
//           ids starting with "staff_" (the 운영진 series) only on admins' entries
//   - proof: optional 64-char hex from the score server (server.mjs) that checked the round:
//           SHA-256 of "<secret>|<uid>|<game>|<score>|<KST day>|<secret>". Required once
//           config/scoreKey.enforce is true; a proof that is there must always match.
//
// Collection: bans  (moderation)
// Document ID: uid of a player blocked from the leaderboards
// Fields: by (admin uid), name (1-40 chars), at (timestamp == request.time)
//
// Document: config/admins  (edited only in the Firebase console)
// Fields: emails - list of Google account emails with admin rights
//
// Document: config/scoreKey  (edited only in the Firebase console, never readable by clients)
// Fields: secret - shared with the score server (its SCORE_SECRET), enforce - bool
//
// Collection: reports  (players flag a leaderboard entry; only admins read)
// Document ID: <boardId>~<targetUid>~<reporterUid> (one report per player per entry)
// Fields: reporter (== auth uid), target (uid, not the reporter), targetName (1-40),
//         board (board id), score (int), reason (name | score | other),
//         note (0-200 chars), at (== request.time), status (open -> done by admins)
//
// Collection: feedback  (bug reports and ideas; only admins read)
// Document ID: <uid>~<5-minute bucket> (at most one message per 5 minutes)
// Fields: uid (== auth uid), name (1-40), kind (bug | idea | other),
//         message (1-1000 chars, may contain line breaks), version (1-20),
//         device (0-200), at (== request.time), status (new -> done by admins)
//
// Collection: push  (streak reminders, one doc per signed-in device that turned them on)
// Document ID: <uid>~<device id, 12 of [a-z0-9]>
// Fields: uid (== auth uid), at (== request.time),
//         box: map { ek, iv, ct } (base64) - the browser's push subscription, last play day and
//         streak, sealed (RSA-OAEP + AES-GCM) for the reminder sender, which alone can open it.
// Readable by anyone because the sender (GitHub Actions) has no sign-in; it learns nothing else.
// Docs not refreshed for 40 days may be deleted by anyone (the sender cleans them up).
//
// Collection: activity/{dayId}/players  (daily play counts for the admin stats)
// Day ID: d<dayIndex> (KST), only today or yesterday can be written
// Document ID: Firebase Auth uid
// Fields: plays (int, +1 per round), seconds (int, total play time), at (== request.time)
//
// ===============================================================

service cloud.firestore {
  // Configured access for 'ai-studio-9fb7cc09-52d2-4de4-9866-b3ecaf99c200' database instance
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isOwner(userId) {
      return isAuthenticated() && isValidId(userId) && request.auth.uid == userId;
    }

    // Signed in with Google (not anonymous or another provider)
    function isGoogleUser() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // Admins are listed by verified Google email in config/admins, so no email lives in this public file
    function isAdmin() {
      return isGoogleUser()
        && request.auth.token.email_verified == true
        && request.auth.token.email in get(/databases/$(database)/documents/config/admins).data.emails;
    }

    function isBanned() {
      return exists(/databases/$(database)/documents/bans/$(request.auth.uid));
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // A string of a limited length without control characters (newlines, etc.)
    function isPlainText(value, minLen, maxLen) {
      return value is string
        && value.size() >= minLen
        && value.size() <= maxLen
        && !value.matches('(?s).*[\\x00-\\x1f\\x7f].*');
    }

    // Free text that may span lines (no other control characters)
    function isMessageText(value, minLen, maxLen) {
      return value is string
        && value.size() >= minLen
        && value.size() <= maxLen
        && !value.matches('(?s).*[\\x00-\\x09\\x0b-\\x1f\\x7f].*');
    }

    // Missing, or an id like "suika_10000" (titles, frames)
    function isOptionalId(m, key) {
      return !(key in m) || (m[key] is string && m[key].matches('^[a-z0-9_]{1,32}$'));
    }

    // Missing, null, or a string up to maxLen
    function isOptionalText(m, key, maxLen) {
      return !(key in m) || m[key] == null || (m[key] is string && m[key].size() <= maxLen);
    }

    // Names that would pass as staff: "Tester", "QA", "관리자", "운영자" ...
    // Same list as isReservedNickname in src/utils/profile.ts
    function isReservedName(name) {
      let lowered = name.lower();
      return lowered.replace('[^a-z가-힣]', '').matches('.*(tester|admin|moderator|developer|official|operator|gamemaster|staff|관리자|운영자|운영진|운영팀|개발자|개발팀|테스터|테스트|공식계정|스태프|큐에이|지엠).*')
        || lowered.matches('(?s)(.*[^a-z])?(qa|gm|dev|mod|test)([^a-z].*)?');
    }

    // ───────── leaderboard period helpers (KST, UTC+9) ─────────

    function kstMillis() {
      return request.time.toMillis() + 32400000;
    }

    // int / int is integer division here (math.floor would turn it into a float)
    function dayIndex() {
      return kstMillis() / 86400000;
    }

    // 1970-01-01 was a Thursday; +3 days makes weeks start on Monday
    function weekIndex() {
      return (dayIndex() + 3) / 7;
    }

    // Only the all-time board, today/yesterday or this/last week can be written
    // (yesterday/last week cover rounds that end right at midnight)
    function isOpenPeriod(period) {
      return period == 'all'
        || period == 'd' + string(dayIndex())
        || period == 'd' + string(dayIndex() - 1)
        || period == 'w' + string(weekIndex())
        || period == 'w' + string(weekIndex() - 1);
    }

    function boardGame(boardId) {
      return boardId.split('_')[0];
    }

    // ───────── score proofs from the score server ─────────

    // { secret, enforce }: only these rules read it (clients have no access)
    function scoreKey() {
      return get(/databases/$(database)/documents/config/scoreKey).data;
    }

    // SHA-256 over the round and its KST day, with the secret at both ends
    function scoreProof(key, uid, game, score, day) {
      return hashing.sha256(key.secret + '|' + uid + '|' + game + '|' + string(score) + '|' + string(day) + '|' + key.secret).toHexString();
    }

    // A proof has to match (signed today or yesterday, for rounds that end at midnight);
    // entries without one are taken only while enforce is off
    function hasValidProof(boardId, uid, data) {
      let key = scoreKey();
      let game = boardGame(boardId);
      return ('proof' in data
          && (data.proof == scoreProof(key, uid, game, data.score, dayIndex())
            || data.proof == scoreProof(key, uid, game, data.score, dayIndex() - 1)))
        || (!('proof' in data) && key.enforce != true);
    }

    function isValidBoardFormat(boardId) {
      return boardId is string && boardId.matches('^(memory|suika|dash|puzzle|slice)_(all|d[0-9]{1,6}|w[0-9]{1,6})$');
    }

    function isValidBoardId(boardId) {
      return isValidBoardFormat(boardId) && isOpenPeriod(boardId.split('_')[1]);
    }

    function isOpenDay(dayId) {
      return dayId == 'd' + string(dayIndex()) || dayId == 'd' + string(dayIndex() - 1);
    }

    // 5-minute buckets for the feedback rate limit
    function feedbackBucket() {
      return request.time.toMillis() / 300000;
    }

    // Caps well above anything reachable in normal play
    function maxScore(game) {
      return {'memory': 2000, 'suika': 100000, 'dash': 100000, 'puzzle': 100000, 'slice': 100000}[game];
    }

    // ===============================================================
    // Domain Validators (used on both create and update)
    // ===============================================================

    function isValidProfile(userId, p) {
      return p is map
        && p.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'lastLoginAt', 'nickname', 'avatar', 'title', 'frame'])
        && p.get('uid', '') == userId
        && isOptionalText(p, 'displayName', 100)
        && isOptionalText(p, 'email', 320)
        && isOptionalText(p, 'photoURL', 2048)
        && isOptionalText(p, 'createdAt', 40)
        && isOptionalText(p, 'lastLoginAt', 40)
        && isOptionalText(p, 'nickname', 40)
        && isOptionalText(p, 'avatar', 16)
        && isOptionalText(p, 'title', 40)
        && isOptionalText(p, 'frame', 40);
    }

    function isValidUserDoc(userId, data) {
      return data.keys().hasOnly(['profile', 'statistics', 'achievements', 'settings', 'inventory', 'stages'])
        && 'profile' in data
        && isValidProfile(userId, data.profile)
        && (!('statistics' in data) || (data.statistics is map && data.statistics.size() <= 40))
        && (!('achievements' in data) || (data.achievements is map && data.achievements.size() <= 100))
        && (!('settings' in data) || (data.settings is map && data.settings.size() <= 40))
        && (!('inventory' in data) || (data.inventory is map && data.inventory.size() <= 100))
        && (!('stages' in data) || (data.stages is map && data.stages.size() <= 100));
    }

    // Who the account belongs to can't be rewritten after sign-up
    function profileIdentityUnchanged() {
      let before = resource.data.get('profile', {});
      let after = request.resource.data.profile;
      return after.get('uid', null) == before.get('uid', null)
        && after.get('email', null) == before.get('email', null)
        && after.get('createdAt', null) == before.get('createdAt', null);
    }

    function isValidScoreEntry(boardId, uid, data) {
      return hasRequiredFields(['uid', 'name', 'avatar', 'score', 'at'])
        && hasOnlyAllowedFields(['uid', 'name', 'avatar', 'score', 'at', 'title', 'frame', 'proof'])
        && data.uid == uid
        && data.uid == request.auth.uid
        && isPlainText(data.name, 1, 40)
        && isPlainText(data.avatar, 1, 16)
        && isOptionalId(data, 'title')
        && isOptionalId(data, 'frame')
        && (!('title' in data) || !data.title.matches('^staff_.*') || isAdmin())
        && (!('frame' in data) || !data.frame.matches('^staff_.*') || isAdmin())
        && (!('proof' in data) || (data.proof is string && data.proof.size() == 64))
        && (!isReservedName(data.name) || isAdmin())
        && data.score is int
        && data.score >= 0
        && data.score <= maxScore(boardGame(boardId))
        && data.at == request.time;
    }

    function isValidReport(reportId, data) {
      return data.keys().hasAll(['reporter', 'target', 'targetName', 'board', 'score', 'reason', 'note', 'at', 'status'])
        && data.keys().hasOnly(['reporter', 'target', 'targetName', 'board', 'score', 'reason', 'note', 'at', 'status'])
        && data.reporter == request.auth.uid
        && isValidId(data.target)
        && data.target != request.auth.uid
        && isPlainText(data.targetName, 1, 40)
        && isValidBoardFormat(data.board)
        && data.score is int
        && data.score >= 0
        && data.score <= 1000000
        && data.reason in ['name', 'score', 'other']
        && isPlainText(data.note, 0, 200)
        && data.at == request.time
        && data.status == 'open'
        && reportId == data.board + '~' + data.target + '~' + request.auth.uid;
    }

    function isValidFeedback(feedbackId, data) {
      return data.keys().hasAll(['uid', 'name', 'kind', 'message', 'version', 'device', 'at', 'status'])
        && data.keys().hasOnly(['uid', 'name', 'kind', 'message', 'version', 'device', 'at', 'status'])
        && data.uid == request.auth.uid
        && isPlainText(data.name, 1, 40)
        && data.kind in ['bug', 'idea', 'other']
        && isMessageText(data.message, 1, 1000)
        && isPlainText(data.version, 1, 20)
        && isPlainText(data.device, 0, 200)
        && data.at == request.time
        && data.status == 'new'
        && (feedbackId == request.auth.uid + '~' + string(feedbackBucket())
          || feedbackId == request.auth.uid + '~' + string(feedbackBucket() - 1));
    }

    function isValidActivity(data) {
      return data.keys().hasAll(['plays', 'seconds', 'at'])
        && data.keys().hasOnly(['plays', 'seconds', 'at'])
        && data.plays is int
        && data.seconds is int
        && data.seconds >= 0
        && data.at == request.time;
    }

    function isValidPush(docId, data) {
      let parts = docId.split('~');
      return data.keys().hasAll(['uid', 'box', 'at'])
        && data.keys().hasOnly(['uid', 'box', 'at'])
        && data.uid == request.auth.uid
        && parts.size() == 2
        && parts[0] == request.auth.uid
        && parts[1].matches('^[a-z0-9]{12}$')
        && data.box is map
        && data.box.keys().hasAll(['ek', 'iv', 'ct'])
        && data.box.keys().hasOnly(['ek', 'iv', 'ct'])
        && data.box.ek is string && data.box.ek.size() > 0 && data.box.ek.size() <= 400
        && data.box.iv is string && data.box.iv.size() > 0 && data.box.iv.size() <= 32
        && data.box.ct is string && data.box.ct.size() > 0 && data.box.ct.size() <= 3000
        && data.at == request.time;
    }

    // Only admins may flip the status field, nothing else
    function isStatusChange(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in allowed;
    }

    function isValidBan(data) {
      return data.keys().hasAll(['by', 'name', 'at'])
        && data.keys().hasOnly(['by', 'name', 'at'])
        && data.by == request.auth.uid
        && isPlainText(data.name, 1, 40)
        && data.at == request.time;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // User personal game data: profile, statistics, achievements, settings (owner only)
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserDoc(userId, request.resource.data);
      allow update: if isOwner(userId)
        && isValidUserDoc(userId, request.resource.data)
        && profileIdentityUnchanged();
      allow delete: if isOwner(userId);
    }

    // Public leaderboards: anyone can view, players can only post their own best
    match /leaderboards/{boardId}/scores/{uid} {
      // Public by design: entries hold only a nickname, emoji avatar and score
      allow read: if true;

      allow create: if isGoogleUser()
        && isOwner(uid)
        && isValidBoardId(boardId)
        && isValidScoreEntry(boardId, uid, request.resource.data)
        && hasValidProof(boardId, uid, request.resource.data)
        && !isBanned();

      // A higher score (with its proof) replaces the entry; with the same score only the look
      // (name, avatar, title, frame) may change. Either way at most every 3 seconds, and the uid never changes.
      allow update: if isGoogleUser()
        && isOwner(uid)
        && resource.data.uid == uid
        && isValidBoardId(boardId)
        && isValidScoreEntry(boardId, uid, request.resource.data)
        && ((request.resource.data.score > resource.data.score && hasValidProof(boardId, uid, request.resource.data))
          || (request.resource.data.score == resource.data.score
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'avatar', 'title', 'frame', 'at'])))
        && request.time > resource.data.at + duration.value(3, 's')
        && !isBanned();

      // Moderation: admins remove cheated scores or bad names
      allow delete: if isAdmin();
    }

    // Players blocked from the leaderboards (admins manage, players can see their own)
    match /bans/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(uid) && isValidBan(request.resource.data);
      allow delete: if isAdmin();
    }

    // Admin list: admins can see that they are admins; nobody edits it from the app
    match /config/admins {
      allow get: if isGoogleUser()
        && request.auth.token.email_verified == true
        && request.auth.token.email in resource.data.emails;
    }

    // Players flag leaderboard entries; admins review them
    match /reports/{reportId} {
      allow create: if isGoogleUser() && isValidReport(reportId, request.resource.data);
      allow read: if isAdmin();
      allow update: if isAdmin() && isStatusChange(['open', 'done']);
      allow delete: if isAdmin();
    }

    // Bug reports and ideas from signed-in players
    match /feedback/{feedbackId} {
      allow create: if isGoogleUser() && isValidFeedback(feedbackId, request.resource.data);
      allow read: if isAdmin();
      allow update: if isAdmin() && isStatusChange(['new', 'done']);
      allow delete: if isAdmin();
    }

    // Streak reminder subscriptions: the owner writes a sealed copy, the sender reads them all
    match /push/{docId} {
      allow read: if true;
      allow create: if isGoogleUser() && isValidPush(docId, request.resource.data);
      allow update: if isGoogleUser()
        && resource.data.uid == request.auth.uid
        && isValidPush(docId, request.resource.data)
        && request.time > resource.data.at + duration.value(2, 's');
      allow delete: if (isGoogleUser() && resource.data.uid == request.auth.uid)
        || request.time > resource.data.at + duration.value(40, 'd');
    }

    // One doc per player per day: rounds played and time, counted for the admin stats
    match /activity/{dayId}/players/{uid} {
      allow read: if isAdmin();
      allow create: if isGoogleUser()
        && isOwner(uid)
        && isOpenDay(dayId)
        && isValidActivity(request.resource.data)
        && request.resource.data.plays == 1
        && request.resource.data.seconds <= 3600;
      allow update: if isGoogleUser()
        && isOwner(uid)
        && isOpenDay(dayId)
        && isValidActivity(request.resource.data)
        && request.resource.data.plays == resource.data.plays + 1
        && request.resource.data.seconds >= resource.data.seconds
        && request.resource.data.seconds <= resource.data.seconds + 3600;
    }

    // Default deny all other paths to prevent unauthorized access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
