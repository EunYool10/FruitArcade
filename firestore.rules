rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users  (private: holds the Google email)
// Document ID: Firebase Auth uid
// Fields:
//   - profile: map (required)
//       uid (== document id, immutable), email (string|null, immutable),
//       createdAt (string, immutable), displayName, photoURL, lastLoginAt,
//       nickname, avatar (strings or null, size-limited). No other keys.
//   - statistics: map (<= 40 keys) - play counts / high scores (older versions left extra keys)
//   - achievements: map (<= 100 keys) - unlocked achievement id -> date
//   - settings: map (<= 40 keys) - game settings
//   No other top-level fields and no subcollections.
//
// Collection: leaderboards/{boardId}/scores  (public)
// Board ID: <game>_<period>
//   - game:   memory | suika | dash | puzzle
//   - period: all            -> all-time board
//             d<dayIndex>    -> daily board, days since 1970-01-01 in KST (UTC+9)
//             w<weekIndex>   -> weekly board, Monday-start weeks since 1969-12-29 in KST
// Document ID: Firebase Auth uid (one entry per player per board)
// Fields (public, no email or Google profile data):
//   - uid: string (== document id == request.auth.uid, immutable)
//   - name: string (1-40 chars, no control characters, may not pose as staff
//           like "Tester", "QA", "관리자" unless written by an admin)
//   - avatar: string (1-16 chars)
//   - score: int (0 <= score <= per-game cap, may only go up, at most every 3 s)
//   - at: timestamp (== request.time)
//
// Collection: bans  (moderation)
// Document ID: uid of a player blocked from the leaderboards
// Fields: by (admin uid), name (1-40 chars), at (timestamp == request.time)
//
// Document: config/admins  (edited only in the Firebase console)
// Fields: emails - list of Google account emails with admin rights
//
// ===============================================================

service cloud.firestore {
  // Configured access for 'ai-studio-9fb7cc09-52d2-4de4-9866-b3ecaf99c200' database instance
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isOwner(userId) {
      return isAuthenticated() && isValidId(userId) && request.auth.uid == userId;
    }

    // Signed in with Google (not anonymous or another provider)
    function isGoogleUser() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // Admins are listed by verified Google email in config/admins, so no email lives in this public file
    function isAdmin() {
      return isGoogleUser()
        && request.auth.token.email_verified == true
        && request.auth.token.email in get(/databases/$(database)/documents/config/admins).data.emails;
    }

    function isBanned() {
      return exists(/databases/$(database)/documents/bans/$(request.auth.uid));
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // A string of a limited length without control characters (newlines, etc.)
    function isPlainText(value, minLen, maxLen) {
      return value is string
        && value.size() >= minLen
        && value.size() <= maxLen
        && !value.matches('(?s).*[\\x00-\\x1f\\x7f].*');
    }

    // Missing, null, or a string up to maxLen
    function isOptionalText(m, key, maxLen) {
      return !(key in m) || m[key] == null || (m[key] is string && m[key].size() <= maxLen);
    }

    // Names that would pass as staff: "Tester", "QA", "관리자", "운영자" ...
    // Same list as isReservedNickname in src/utils/profile.ts
    function isReservedName(name) {
      let lowered = name.lower();
      return lowered.replace('[^a-z가-힣]', '').matches('.*(tester|admin|moderator|developer|official|operator|gamemaster|staff|관리자|운영자|운영진|운영팀|개발자|개발팀|테스터|테스트|공식계정|스태프|큐에이|지엠).*')
        || lowered.matches('(?s)(.*[^a-z])?(qa|gm|dev|mod|test)([^a-z].*)?');
    }

    // ───────── leaderboard period helpers (KST, UTC+9) ─────────

    function kstMillis() {
      return request.time.toMillis() + 32400000;
    }

    // int / int is integer division here (math.floor would turn it into a float)
    function dayIndex() {
      return kstMillis() / 86400000;
    }

    // 1970-01-01 was a Thursday; +3 days makes weeks start on Monday
    function weekIndex() {
      return (dayIndex() + 3) / 7;
    }

    // Only the all-time board, today/yesterday or this/last week can be written
    // (yesterday/last week cover rounds that end right at midnight)
    function isOpenPeriod(period) {
      return period == 'all'
        || period == 'd' + string(dayIndex())
        || period == 'd' + string(dayIndex() - 1)
        || period == 'w' + string(weekIndex())
        || period == 'w' + string(weekIndex() - 1);
    }

    function boardGame(boardId) {
      return boardId.split('_')[0];
    }

    function isValidBoardId(boardId) {
      return boardId is string
        && boardId.matches('^(memory|suika|dash|puzzle)_(all|d[0-9]{1,6}|w[0-9]{1,6})$')
        && isOpenPeriod(boardId.split('_')[1]);
    }

    // Caps well above anything reachable in normal play
    function maxScore(game) {
      return {'memory': 2000, 'suika': 100000, 'dash': 100000, 'puzzle': 100000}[game];
    }

    // ===============================================================
    // Domain Validators (used on both create and update)
    // ===============================================================

    function isValidProfile(userId, p) {
      return p is map
        && p.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'lastLoginAt', 'nickname', 'avatar'])
        && p.get('uid', '') == userId
        && isOptionalText(p, 'displayName', 100)
        && isOptionalText(p, 'email', 320)
        && isOptionalText(p, 'photoURL', 2048)
        && isOptionalText(p, 'createdAt', 40)
        && isOptionalText(p, 'lastLoginAt', 40)
        && isOptionalText(p, 'nickname', 40)
        && isOptionalText(p, 'avatar', 16);
    }

    function isValidUserDoc(userId, data) {
      return data.keys().hasOnly(['profile', 'statistics', 'achievements', 'settings'])
        && 'profile' in data
        && isValidProfile(userId, data.profile)
        && (!('statistics' in data) || (data.statistics is map && data.statistics.size() <= 40))
        && (!('achievements' in data) || (data.achievements is map && data.achievements.size() <= 100))
        && (!('settings' in data) || (data.settings is map && data.settings.size() <= 40));
    }

    // Who the account belongs to can't be rewritten after sign-up
    function profileIdentityUnchanged() {
      let before = resource.data.get('profile', {});
      let after = request.resource.data.profile;
      return after.get('uid', null) == before.get('uid', null)
        && after.get('email', null) == before.get('email', null)
        && after.get('createdAt', null) == before.get('createdAt', null);
    }

    function isValidScoreEntry(boardId, uid, data) {
      return hasRequiredFields(['uid', 'name', 'avatar', 'score', 'at'])
        && hasOnlyAllowedFields(['uid', 'name', 'avatar', 'score', 'at'])
        && data.uid == uid
        && data.uid == request.auth.uid
        && isPlainText(data.name, 1, 40)
        && isPlainText(data.avatar, 1, 16)
        && (!isReservedName(data.name) || isAdmin())
        && data.score is int
        && data.score >= 0
        && data.score <= maxScore(boardGame(boardId))
        && data.at == request.time;
    }

    function isValidBan(data) {
      return data.keys().hasAll(['by', 'name', 'at'])
        && data.keys().hasOnly(['by', 'name', 'at'])
        && data.by == request.auth.uid
        && isPlainText(data.name, 1, 40)
        && data.at == request.time;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // User personal game data: profile, statistics, achievements, settings (owner only)
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserDoc(userId, request.resource.data);
      allow update: if isOwner(userId)
        && isValidUserDoc(userId, request.resource.data)
        && profileIdentityUnchanged();
      allow delete: if isOwner(userId);
    }

    // Public leaderboards: anyone can view, players can only post their own best
    match /leaderboards/{boardId}/scores/{uid} {
      // Public by design: entries hold only a nickname, emoji avatar and score
      allow read: if true;

      allow create: if isGoogleUser()
        && isOwner(uid)
        && isValidBoardId(boardId)
        && isValidScoreEntry(boardId, uid, request.resource.data)
        && !isBanned();

      // Only a higher score replaces the entry, at most every 3 seconds; uid can never change
      allow update: if isGoogleUser()
        && isOwner(uid)
        && resource.data.uid == uid
        && isValidBoardId(boardId)
        && isValidScoreEntry(boardId, uid, request.resource.data)
        && request.resource.data.score > resource.data.score
        && request.time > resource.data.at + duration.value(3, 's')
        && !isBanned();

      // Moderation: admins remove cheated scores or bad names
      allow delete: if isAdmin();
    }

    // Players blocked from the leaderboards (admins manage, players can see their own)
    match /bans/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(uid) && isValidBan(request.resource.data);
      allow delete: if isAdmin();
    }

    // Admin list: admins can see that they are admins; nobody edits it from the app
    match /config/admins {
      allow get: if isGoogleUser()
        && request.auth.token.email_verified == true
        && request.auth.token.email in resource.data.emails;
    }

    // Default deny all other paths to prevent unauthorized access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
